# ARKA — AI Configuration
# Copy this file to .env and fill in your actual API keys

# Groq API — Primary AI (text, agent, fast inference)
# Get your key at: https://console.groq.com/keys
# Key format starts with: gsk_
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API — Multimodal AI (image/video analysis)
# Get your key at: https://aistudio.google.com/apikey
# Key format starts with: AQ
GEMINI_API_KEY=your_gemini_api_key_here

# Server Config
PORT=5000

# Supabase Cloud (Database & Storage)
# Get these from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional: Service Role Key for elevated backend access
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
